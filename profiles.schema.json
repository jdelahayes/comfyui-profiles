{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jdelahayes/comfyui-profiles/main/profiles.schema.json",
  "title": "Profils comfyui-profiles",
  "description": "ComfyUI usage profiles file: models, custom nodes, workflows and pip packages of each use case. Keys starting with // are comments.",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "$schema": {"type": "string"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[\\w.-]+$"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "patternProperties": {"^//": {}},
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "description": {"type": "string", "description": "Free text, shown in the panel and by `list`."},
        "size": {"type": "string", "description": "Total size, computed by profile_sizes.py (informative)."},
        "extends": {
          "type": "array",
          "description": "Profiles whose whole content this one includes.",
          "items": {"type": "string"}
        },
        "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
        "workflows": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "custom_nodes": {"type": "array", "items": {"$ref": "#/$defs/custom_node"}},
        "pip": {
          "type": "array",
          "description": "pip packages (pip install specs).",
          "items": {"type": "string"}
        }
      },
      "patternProperties": {"^//": {}},
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "description": "A file to download, from a single source: hf, github, civitai or url.",
      "properties": {
        "hf": {"type": "string", "description": "Hugging Face repository (org/repo), with file."},
        "github": {"type": "string", "description": "Public GitHub repository (owner/repo or its URL), with file. Only the file is downloaded."},
        "civitai": {"type": "integer", "description": "VERSION id of a CivitAI model (CIVITAI_TOKEN), with name."},
        "url": {"type": "string", "description": "Direct URL, with name."},
        "file": {"type": "string", "description": "Path of the file in the repository (hf, github)."},
        "revision": {"type": "string", "description": "Branch, tag or commit (hf, github)."},
        "name": {"type": "string", "description": "Local file name. Default: the name of file (hf, github)."},
        "size": {"type": "integer", "description": "Size in bytes, computed by profile_sizes.py."}
      },
      "oneOf": [
        {"required": ["hf", "file"]},
        {"required": ["github", "file"]},
        {"required": ["civitai", "name"]},
        {"required": ["url", "name"]}
      ],
      "patternProperties": {"^//": {}}
    },
    "model": {
      "allOf": [{"$ref": "#/$defs/file"}],
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "description": "Subfolder of models/: checkpoints, loras, vae, diffusion_models, text_encoders... (may contain a subfolder, e.g. diffusion_models/krea2)."}
      }
    },
    "custom_node": {
      "type": "object",
      "properties": {
        "git": {"type": "string", "description": "URL of the git repository."},
        "ref": {"type": "string", "description": "Branch, tag or commit (git only)."},
        "gdrive": {"type": "string", "description": "Public zip on Google Drive (share link or id), with name. Encrypted: GDRIVE_ZIP_PASSWORD."},
        "name": {"type": "string", "description": "Folder name in custom_nodes/. Default: the name of the git repository."}
      },
      "oneOf": [
        {"required": ["git"], "not": {"required": ["gdrive"]}},
        {"required": ["gdrive", "name"], "not": {"anyOf": [{"required": ["git"]}, {"required": ["ref"]}]}}
      ],
      "patternProperties": {"^//": {}},
      "additionalProperties": false
    }
  }
}
